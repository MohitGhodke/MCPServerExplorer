.vscode/**
.vscode-test/**
.github/**
src/**
**/*.map
# Covers the .d.ts declaration files tsc emits next to the JS in out/.
# Do NOT add a `!out/**` negation below this line — it re-includes them,
# along with the source maps.
**/*.ts
.gitignore
tsconfig.json
# devDependencies are excluded by vsce automatically; only production deps (jsonc-parser) are bundled.
# Do NOT add node_modules/** here — that would strip the jsonc-parser runtime dependency
# and cause 'Cannot find module jsonc-parser' errors in the installed extension.
